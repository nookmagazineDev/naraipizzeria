# ── ตัวอย่างไฟล์เก็บค่าเชื่อมต่อ SQL Server ──
# 1) คัดลอกไฟล์นี้เป็น  db.env.ps1  (ไฟล์จริงจะไม่ขึ้น git)
# 2) ใส่รหัสผ่านจริง
# 3) start-narai.ps1 จะ . (dot-source) ไฟล์นี้ให้อัตโนมัติ

$env:DB_SERVER   = 'localhost'      # named instance ใช้ 'localhost\SQLEXPRESS' (แล้วลบ DB_PORT)
$env:DB_PORT     = '1433'
$env:DB_NAME     = 'NaraiPos'
$env:DB_USER     = 'SA'
$env:DB_PASSWORD = 'ใส่รหัสจริงตรงนี้'

# ── ZKBio Time 9 (เครื่องสแกนหน้า/นิ้ว) — ฐานข้อมูลแยกบน SQLEXPRESS ──
# ค่า default ในโค้ดตรงกับเครื่องที่ร้านอยู่แล้ว (localhost\SQLEXPRESS / ZKBio9)
# → ปกติไม่ต้องตั้ง 2 บรรทัดนี้ ตั้งเฉพาะเวลาย้ายเครื่องหรือเปลี่ยนชื่อ DB
#$env:ZK_DB_SERVER   = 'localhost\SQLEXPRESS'
#$env:ZK_DB_NAME     = 'ZKBio9'
# ตั้ง 2 บรรทัดล่างเฉพาะเมื่อ login ของ NaraiPos ด้านบนเข้า ZKBio9 ไม่ได้
#$env:ZK_DB_USER     = 'administrator'
#$env:ZK_DB_PASSWORD = 'ใส่รหัสจริงตรงนี้'

# ── QC/RD (เมนู · สูตร BOM · วัตถุดิบ) — ฐาน InventoryNarai บนอินสแตนซ์เดียวกัน ──
# ตั้งเมื่อย้ายข้อมูล QC/RD ขึ้น SQL แล้ว (ดู docs/qcrd-sql-migration.md)
# ไม่ตั้ง QCRD_DB_* = ใช้ค่า DB_* ด้านบน แต่เปลี่ยนฐานเป็น InventoryNarai ให้เอง
#$env:QCRD_DB_SERVER   = 'localhost\SQLEXPRESS'
#$env:QCRD_DB_NAME     = 'InventoryNarai'
#$env:QCRD_DB_USER     = '<user>'
#$env:QCRD_DB_PASSWORD = 'ใส่รหัสจริงตรงนี้'
# กุญแจสำหรับ POST /qcrd/save — ต้องตั้งค่าเดียวกันเป็น env QCRD_WRITE_KEY บน Vercel ด้วย
# ไม่ตั้ง = ปิดการเขียนไว้ (หน้า QC/RD จะดูข้อมูลได้อย่างเดียว)
#$env:QCRD_WRITE_KEY   = '<สุ่มข้อความยาว ๆ มาสักชุด>'
